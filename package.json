{
  "name": "@mr_hugo/boredom",
  "version": "1.0.0",
  "description": "Another boring JavaScript framework.",
  "type": "module",
  "license": "CC0-1.0",
  "author": "Hugo Daniel",
  "repository": "github:HugoDaniel/boreDOM",
  "homepage": "https://hugodaniel.com/pages/boredom/",
  "main": "./dist/boredom.js",
  "module": "./dist/boredom.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/boredom.js",
      "default": "./dist/boredom.js"
    },
    "./iife": "./dist/boredom.iife.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "boredom": "./bin/serve.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && pnpm run test:unit && pnpm run test:browser",
    "test:unit": "node --test tests/unit/",
    "test:browser": "node scripts/test.mjs",
    "test:watch": "node scripts/test-browser.mjs",
    "serve": "node bin/serve.js",
    "profile": "node scripts/profile.mjs"
  },
  "keywords": [
    "dom",
    "framework",
    "frontend",
    "web-components",
    "no-build",
    "boredom"
  ],
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.13.1"
}
